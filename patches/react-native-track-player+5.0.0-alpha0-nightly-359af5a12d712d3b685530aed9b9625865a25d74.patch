+package com.doublesymmetry.kotlinaudio.players
+
+import android.content.Context
+import android.os.Looper
+import androidx.media3.common.C
+import androidx.media3.common.MediaItem
+import androidx.media3.common.PlaybackException
+import androidx.media3.common.PlaybackParameters
+import androidx.media3.common.Player
+import androidx.media3.exoplayer.ExoPlayer
+import org.junit.After
+import org.junit.Assert.*
+import org.junit.Before
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.mockito.ArgumentMatchers.*
+import org.mockito.Mockito.*
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.RuntimeEnvironment
+import org.robolectric.Shadows.shadowOf
+import org.robolectric.annotation.Config
+import java.time.Duration
+
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [28], manifest = Config.NONE)
+class CrossfadeCoordinatorTest {
+    private lateinit var host: Host
+    private lateinit var coordinator: CrossfadeCoordinator
+    private val context get() = RuntimeEnvironment.getApplication() as Context
+    private fun settings(seconds: Int = 6, allowed: Boolean = true) {
+        context.getSharedPreferences("mmplayer_crossfade", Context.MODE_PRIVATE).edit()
+            .putInt("durationMs", seconds * 1000).putBoolean("allowed", allowed).commit()
+    }
+    private fun tick(ms: Long = 250) { shadowOf(Looper.getMainLooper()).idleFor(Duration.ofMillis(ms)) }
+
+    @Before fun setup() {
+        settings()
+        host = Host()
+        coordinator = CrossfadeCoordinator(host, context)
+        coordinator.wake()
+        tick(0)
+    }
+    @After fun teardown() { coordinator.destroy() }
+
+    @Test fun preparesSilentlyThenActivatesTheIncomingEntryExactlyOnce() {
+        assertEquals(0, host.created.size)
+        host.active.position = 22000
+        tick()
+        val incoming = host.created.single()
+        assertEquals(0f, incoming.volume, 0f)
+        assertFalse(incoming.playing)
+        assertEquals(0, host.transitions.size)
+        host.active.position = 24000
+        tick()
+        assertSame(incoming, host.active)
+        assertTrue(coordinator.isMixing())
+        assertEquals(listOf(0), host.transitions)
+        tick(1000)
+        assertEquals(1, host.transitions.size)
+        assertTrue(incoming.volume > 0f)
+    }
+
+    @Test fun disablingDuringTheMixFinishesItAndDoesNotPrepareAnotherSong() {
+        startMix()
+        settings(0)
+        tick(0)
+        assertTrue(coordinator.isMixing())
+        tick(6500)
+        assertFalse(coordinator.isMixing())
+        assertEquals(1f, host.active.volume, 0.0001f)
+        assertEquals(1, host.created.size)
+    }
+
+    @Test fun pauseAndResumeFreezeBothAudioAndTheEnvelope() {
+        val outgoing = startMix()
+        tick(1000)
+        host.active.playing = false
+        coordinator.pauseTail()
+        val a = outgoing.volume
+        val b = host.active.volume
+        tick(20000)
+        assertFalse(outgoing.playing)
+        assertEquals(a, outgoing.volume, 0.0001f)
+        assertEquals(b, host.active.volume, 0.0001f)
+        host.active.playing = true
+        tick(1000)
+        assertTrue(outgoing.playing)
+        assertTrue(host.active.volume > b)
+    }
+
+    @Test fun futureQueueEditsKeepAnAudibleIncomingSongButInvalidateSilentPreparation() {
+        host.active.position = 22000
+        tick()
+        val stale = host.created.single()
+        coordinator.queueWillChange()
+        assertTrue(stale.released)
+        host.active.position = 24000
+        tick()
+        val incoming = host.active
+        coordinator.queueWillChange()
+        tick()
+        assertSame(incoming, host.active)
+        assertTrue(coordinator.isMixing())
+    }
+
+    @Test fun suspensionConsolidatesTheIncomingSongBeforeQueueOrCastCapture() {
+        val outgoing = startMix()
+        val incoming = host.active
+        incoming.position = 1500
+        settings(6, false)
+        coordinator.refreshPolicy()
+        assertFalse(coordinator.isMixing())
+        assertTrue(outgoing.released)
+        assertSame(incoming, host.active)
+        assertEquals(1500L, incoming.position)
+        assertEquals(1f, incoming.volume, 0f)
+    }
+
+    @Test fun shortIncomingSongDelaysTheStartInsteadOfCuttingTheOutgoingEnding() {
+        settings(12)
+        host.nextDuration = 4000
+        host.active.position = 18000
+        tick()
+        assertFalse(coordinator.isMixing())
+        host.active.position = 27000
+        tick()
+        assertFalse(coordinator.isMixing())
+        host.active.position = 28000
+        tick()
+        assertTrue(coordinator.isMixing())
+    }
+
+    @Test fun repeatsTheQueueAcrossTheBoundaryButNeverCrossfadesRepeatOneOrASingleEntry() {
+        host.active.index = 2
+        host.active.repeat = Player.REPEAT_MODE_ALL
+        host.active.position = 24000
+        tick()
+        assertTrue(coordinator.isMixing())
+        assertEquals(0, host.active.index)
+        assertEquals(listOf(2), host.transitions)
+        coordinator.cancel()
+        host.active.repeat = Player.REPEAT_MODE_ONE
+        host.active.position = 24000
+        tick()
+        assertFalse(coordinator.isMixing())
+        host.items = listOf(host.items.first())
+        host.active.items = host.items
+        host.active.repeat = Player.REPEAT_MODE_ALL
+        tick()
+        assertFalse(coordinator.isMixing())
+    }
+
+    @Test fun endOfQueueDoesNotInventARandomSuccessor() {
+        host.active.index = 2
+        host.active.position = 24000
+        tick()
+        assertEquals(0, host.created.size)
+        assertFalse(coordinator.isMixing())
+    }
+
+    @Test fun refusedSharedAudioSessionFallsBackWithoutAnUnprocessedOverlap() {
+        host.nextSession = 99
+        host.active.position = 24000
+        tick()
+        assertFalse(coordinator.isMixing())
+        assertEquals(0, host.transitions.size)
+        assertEquals(0, host.active.index)
+        assertTrue(host.created.single().released)
+    }
+
+    @Test fun preparedDecoderErrorDoesNotChangeTheActiveSongOrRetryItGlobally() {
+        host.active.position = 22000
+        tick()
+        val deck = host.created.single()
+        val error = PlaybackException("Cannot decode", null, PlaybackException.ERROR_CODE_DECODING_FAILED)
+        deck.listeners.toList().forEach { it.onPlayerError(error) }
+        host.active.position = 24000
+        tick()
+        assertTrue(deck.released)
+        assertEquals(0, host.active.index)
+        assertEquals(0, host.transitions.size)
+        assertEquals(1, host.created.size)
+    }
+
+    @Test fun seekAndResetReleaseTheTailAndRestoreTheLogicalVolume() {
+        val outgoing = startMix()
+        coordinator.setMasterVolume(0.4f)
+        coordinator.cancelForSeek()
+        assertTrue(outgoing.released)
+        assertEquals(0.4f, host.active.volume, 0.0001f)
+        coordinator.destroy()
+        tick(20000)
+        assertEquals(1, host.created.size)
+    }
+
+    @Test fun theOutgoingDeckNeverStartsItsOwnNextEntryAfterReachingItsBoundary() {
+        val outgoing = startMix()
+        outgoing.index = 1
+        outgoing.playing = false
+        tick(50)
+        assertFalse(coordinator.isMixing())
+        assertFalse(outgoing.playing)
+        assertTrue(outgoing.released)
+        assertEquals(1, host.transitions.size)
+        assertEquals(1f, host.active.volume, 0.0001f)
+    }
+
+    @Test fun repeatChangesDuringPreparationAreKeptWhenTheIncomingDeckBecomesActive() {
+        host.active.position = 22000
+        tick()
+        host.active.repeat = Player.REPEAT_MODE_ALL
+        host.active.position = 24000
+        tick()
+        assertTrue(coordinator.isMixing())
+        assertEquals(Player.REPEAT_MODE_ALL, host.active.repeat)
+    }
+
+    private fun startMix(): Deck {
+        val outgoing = host.active
+        outgoing.position = 24000
+        tick()
+        assertTrue(coordinator.isMixing())
+        return outgoing
+    }
+
+    private class Host : CrossfadeHost {
+        var items = (0..2).map { MediaItem.Builder().setMediaId("entry-$it").setUri("file:///song-$it.mp3").build() }
+        var active = Deck(items)
+        var nextDuration = 30000L
+        var nextSession = 42
+        val created = mutableListOf<Deck>()
+        val transitions = mutableListOf<Int>()
+        override val crossfadePlayer get() = active.player
+        override fun crossfadeItems() = items
+        override fun createDeck(): Pair<ExoPlayer, ReplayGainRenderersFactory> {
