+/** Owns only secondary ExoPlayers. Their release must never release the shared cache. */
+interface CrossfadeHost {
+    val crossfadePlayer: ExoPlayer
+    fun crossfadeItem(index: Int): MediaItem? = crossfadeItems().getOrNull(index)
+    fun crossfadeItems(): List<MediaItem>
+    fun createDeck(): Pair<ExoPlayer, ReplayGainRenderersFactory>
+    fun promote(deck: ExoPlayer, renderer: ReplayGainRenderersFactory)
+    fun crossfadeStarted(index: Int, position: Long, transitionId: String)
+}
+
+class CrossfadeCoordinator(private val host: CrossfadeHost, context: Context) {
+    private val preferences = context.getSharedPreferences("mmplayer_crossfade", Context.MODE_PRIVATE)
+    private val handler = Handler(Looper.getMainLooper())
+    private var prepared: ExoPlayer? = null
+    private var renderer: ReplayGainRenderersFactory? = null
+    private var outgoing: ExoPlayer? = null
+    private var envelope: CrossfadeEnvelope? = null
+    private var observed: ExoPlayer? = null
+    private var destroyed = false
+    private var seekBlockedId: String? = null
+    private var failedId: String? = null
+    private var previousIncomingGain = 1f
+    private var masterVolume = 1f
+    private var outgoingIndex = -1
+    private var incomingId: String? = null
+    private var deckIndex = -1
+    private var scheduled = false
+    private val preferenceListener = SharedPreferences.OnSharedPreferenceChangeListener { _, _ ->
+        handler.post { if (!destroyed) { applyPolicy(); wake() } }
+    }
+    private val transportListener = object : Player.Listener {
+        override fun onIsPlayingChanged(isPlaying: Boolean) {
+            if (!isPlaying) pauseTail()
+            wake()
+        }
+        override fun onPlayWhenReadyChanged(playWhenReady: Boolean, reason: Int) {
+            if (!playWhenReady) pauseTail()
+            wake()
+        }
+    }
+    private val tick = Runnable {
+        scheduled = false
+        try { runTick() } catch (error: Exception) {
+            failedId = prepared?.currentMediaItem?.mediaId
+            cancel()
+            timber.log.Timber.w(error, "Crossfade unavailable; keeping ordinary playback")
+        }
+    }
+
+    init { preferences.registerOnSharedPreferenceChangeListener(preferenceListener) }
+
+    private fun configured() = preferences.getInt("durationMs", 0).coerceIn(0, 12000).toLong()
+    private fun allowed() = preferences.getBoolean("allowed", false)
+    fun isMixing() = outgoing != null
+
+    fun wake() {
