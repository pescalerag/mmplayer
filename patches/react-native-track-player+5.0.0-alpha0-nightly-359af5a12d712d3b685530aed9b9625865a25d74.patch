+package com.doublesymmetry.kotlinaudio.players
+
+import java.nio.ByteBuffer
+import kotlin.math.pow
+import kotlin.math.roundToInt
+
+/** Kept Android-free for signal-level regression tests. */
+object ReplayGainMath {
+    fun multiplier(enabled: Boolean, gainDb: Double?, peak: Double?, preampDb: Double, fallbackDb: Double): Double {
+        if (!enabled) return 1.0
+        val gain = gainDb?.takeIf { it.isFinite() } ?: fallbackDb.takeIf { it.isFinite() } ?: 0.0
+        val preamp = preampDb.takeIf { it.isFinite() } ?: 0.0
+        val requested = 10.0.pow((gain + preamp).coerceIn(-120.0, 60.0) / 20.0)
+        // Unknown peak: assume full scale, allowing attenuation but no unsafe boost.
+        val safePeak = peak?.takeIf { it.isFinite() && it > 0.0 } ?: 1.0
+        return minOf(requested, 1.0 / safePeak)
+    }
+
+    fun processPcm16(input: ByteBuffer, output: ByteBuffer, gain: Double) {
+        if (gain == 1.0) output.put(input)
+        else while (input.remaining() >= 2) output.putShort(scaleSample(input.short.toInt(), gain).toShort())
+    }
+
+    fun scaleSample(sample: Int, gain: Double): Int =
+        (sample * gain).roundToInt().coerceIn(Short.MIN_VALUE.toInt(), Short.MAX_VALUE.toInt())
+}
