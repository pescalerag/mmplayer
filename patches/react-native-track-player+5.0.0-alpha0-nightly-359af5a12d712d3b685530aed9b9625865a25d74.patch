+package com.doublesymmetry.kotlinaudio.players
+
+import android.media.AudioManager
+import com.doublesymmetry.kotlinaudio.models.PlayerOptions
+import org.junit.Assert.*
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.RuntimeEnvironment
+import org.robolectric.annotation.Config
+
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [28], manifest = Config.NONE)
+class PlaybackFocusTest {
+    @Test fun transientInterruptionPausesAndResumesThroughTheSharedTransport() {
+        val player = QueuedAudioPlayer(RuntimeEnvironment.getApplication(), PlayerOptions(handleAudioFocus = true))
+        try {
+            player.play()
+            assertTrue(player.exoPlayer.playWhenReady)
+            player.focusManager.handleAudioFocusChange(AudioManager.AUDIOFOCUS_LOSS_TRANSIENT)
+            assertFalse(player.exoPlayer.playWhenReady)
+            player.focusManager.handleAudioFocusChange(AudioManager.AUDIOFOCUS_GAIN)
+            assertTrue(player.exoPlayer.playWhenReady)
+        } finally { player.destroy() }
+    }
+
+    @Test fun explicitPauseDuringAnInterruptionPreventsAutomaticResume() {
+        val player = QueuedAudioPlayer(RuntimeEnvironment.getApplication(), PlayerOptions(handleAudioFocus = true))
+        try {
+            player.play()
+            player.focusManager.handleAudioFocusChange(AudioManager.AUDIOFOCUS_LOSS_TRANSIENT)
+            player.pause()
+            player.focusManager.handleAudioFocusChange(AudioManager.AUDIOFOCUS_GAIN)
+            assertFalse(player.exoPlayer.playWhenReady)
+        } finally { player.destroy() }
+    }
+
+    @Test fun duckingDoesNotCompoundOrChangeTheUsersLogicalVolume() {
+        val player = QueuedAudioPlayer(RuntimeEnvironment.getApplication(),
+            PlayerOptions(handleAudioFocus = true, alwaysPauseOnInterruption = false))
+        try {
+            player.volume = 0.8f
+            player.focusManager.handleAudioFocusChange(AudioManager.AUDIOFOCUS_LOSS_TRANSIENT_CAN_DUCK)
+            assertEquals(0.8f, player.volume, 0.0001f)
+            assertEquals(0.4f, player.exoPlayer.volume, 0.0001f)
+            player.focusManager.handleAudioFocusChange(AudioManager.AUDIOFOCUS_LOSS_TRANSIENT_CAN_DUCK)
+            assertEquals(0.4f, player.exoPlayer.volume, 0.0001f)
+            player.volume = 0.6f
+            assertEquals(0.3f, player.exoPlayer.volume, 0.0001f)
+            player.focusManager.handleAudioFocusChange(AudioManager.AUDIOFOCUS_GAIN)
+            assertEquals(0.6f, player.exoPlayer.volume, 0.0001f)
+        } finally { player.destroy() }
+    }
+
+    @Test fun permanentFocusLossNeverRestartsPlayback() {
+        val player = QueuedAudioPlayer(RuntimeEnvironment.getApplication(), PlayerOptions(handleAudioFocus = true))
+        try {
+            player.play()
+            player.focusManager.handleAudioFocusChange(AudioManager.AUDIOFOCUS_LOSS)
+            player.focusManager.handleAudioFocusChange(AudioManager.AUDIOFOCUS_GAIN)
+            assertFalse(player.exoPlayer.playWhenReady)
+        } finally { player.destroy() }
+    }
+}
