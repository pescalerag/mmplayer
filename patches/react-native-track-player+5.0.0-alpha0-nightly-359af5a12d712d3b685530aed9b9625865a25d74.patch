+
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [28], manifest = Config.NONE)
+class CrossfadeCoordinatorTest {
+    private lateinit var host: Host
+    private lateinit var coordinator: CrossfadeCoordinator
+    private val context get() = RuntimeEnvironment.getApplication() as Context
+    private fun settings(seconds: Int = 6, allowed: Boolean = true) {
+        context.getSharedPreferences("mmplayer_crossfade", Context.MODE_PRIVATE).edit()
+            .putInt("durationMs", seconds * 1000).putBoolean("allowed", allowed).commit()
+    }
+    private fun tick(ms: Long = 250) { shadowOf(Looper.getMainLooper()).idleFor(Duration.ofMillis(ms)) }
+
+    @Before fun setup() {
+        settings()
+        host = Host()
+        coordinator = CrossfadeCoordinator(host, context)
+        coordinator.wake()
+        tick(0)
+    }
+    @After fun teardown() { coordinator.destroy() }
+
+    @Test fun preparesSilentlyThenActivatesTheIncomingEntryExactlyOnce() {
+        assertEquals(0, host.created.size)
+        host.active.position = 22000
+        tick()
+        val incoming = host.created.single()
+        assertEquals(0f, incoming.volume, 0f)
+        assertFalse(incoming.playing)
+        assertEquals(0, host.transitions.size)
+        host.active.position = 24000
+        tick()
+        assertSame(incoming, host.active)
+        assertTrue(coordinator.isMixing())
+        assertEquals(listOf(0), host.transitions)
+        tick(1000)
+        assertEquals(1, host.transitions.size)
+        assertTrue(incoming.volume > 0f)
+    }
+
+    @Test fun disablingDuringTheMixFinishesItAndDoesNotPrepareAnotherSong() {
+        startMix()
+        settings(0)
+        tick(0)
+        assertTrue(coordinator.isMixing())
+        tick(6500)
+        assertFalse(coordinator.isMixing())
+        assertEquals(1f, host.active.volume, 0.0001f)
+        assertEquals(1, host.created.size)
+    }
+
+    @Test fun pauseAndResumeFreezeBothAudioAndTheEnvelope() {
+        val outgoing = startMix()
+        tick(1000)
+        host.active.playing = false
+        coordinator.pauseTail()
+        val a = outgoing.volume
+        val b = host.active.volume
+        tick(20000)
+        assertFalse(outgoing.playing)
+        assertEquals(a, outgoing.volume, 0.0001f)
+        assertEquals(b, host.active.volume, 0.0001f)
+        host.active.playing = true
+        tick(1000)
+        assertTrue(outgoing.playing)
+        assertTrue(host.active.volume > b)
+    }
+
+    @Test fun futureQueueEditsKeepAnAudibleIncomingSongButInvalidateSilentPreparation() {
+        host.active.position = 22000
+        tick()
+        val stale = host.created.single()
+        coordinator.queueWillChange()
+        assertTrue(stale.released)
+        host.active.position = 24000
+        tick()
+        val incoming = host.active
+        coordinator.queueWillChange()
+        tick()
+        assertSame(incoming, host.active)
+        assertTrue(coordinator.isMixing())
+    }
+
+    @Test fun suspensionConsolidatesTheIncomingSongBeforeQueueOrCastCapture() {
+        val outgoing = startMix()
+        val incoming = host.active
+        incoming.position = 1500
+        settings(6, false)
+        coordinator.refreshPolicy()
+        assertFalse(coordinator.isMixing())
+        assertTrue(outgoing.released)
+        assertSame(incoming, host.active)
+        assertEquals(1500L, incoming.position)
+        assertEquals(1f, incoming.volume, 0f)
+    }
+
+    @Test fun shortIncomingSongDelaysTheStartInsteadOfCuttingTheOutgoingEnding() {
+        settings(12)
+        host.nextDuration = 4000
+        host.active.position = 18000
