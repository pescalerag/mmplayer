@@ -0,0 +1,51 @@
+package com.doublesymmetry.kotlinaudio.players
+
+import org.junit.Assert.*
+import org.junit.Test
+
+class CrossfadeEnvelopeTest {
+    @Test fun pausePreservesTheMixAcrossLongBackgroundIntervals() {
+        val fade = CrossfadeEnvelope(6000)
+        fade.advance(1000, true)
+        fade.advance(2500, false)
+        val before = fade.gains()
+        fade.advance(95000, false)
+        assertEquals(before, fade.gains())
+        fade.advance(100000, true)
+        fade.advance(101500, true)
+        assertEquals(3000L, fade.elapsedMs)
+        val (a, b) = fade.gains()
+        assertEquals(1f, a * a + b * b, 0.00001f)
+        assertEquals(a, b, 0.00001f)
+    }
+    @Test fun finishesExactlyAndClampsLateOrBackwardsTicks() {
+        val fade = CrossfadeEnvelope(1000)
+        fade.advance(1000, true)
+        fade.advance(900, true)
+        assertEquals(0L, fade.elapsedMs)
+        fade.advance(10000, true)
+        assertEquals(1000L, fade.elapsedMs)
+        assertEquals(0f, fade.gains().first, 0.00001f)
+        assertEquals(1f, fade.gains().second, 0.00001f)
+    }
+    @Test fun speedChangesPreserveGainAndFinishWithTheOutgoingAudio() {
+        val fade = CrossfadeEnvelope(6000)
+        fade.advance(1000, true)
+        fade.advance(4000, true)
+        val before = fade.gains()
+        fade.retimeRemaining(6000)
+        assertEquals(before.first, fade.gains().first, 0.0001f)
+        assertEquals(before.second, fade.gains().second, 0.0001f)
+        fade.advance(10000, true)
+        assertEquals(1f, fade.gains().second, 0.0001f)
+    }
+    @Test fun shortSongsAndPlaybackSpeedBoundBothTransitionWindows() {
+        assertEquals(2000L, CrossfadeEnvelope.duration(12000, 30000, 30000, 4000, 1f))
+        assertEquals(1000L, CrossfadeEnvelope.duration(12000, 30000, 30000, 4000, 2f))
+        assertEquals(500L, CrossfadeEnvelope.duration(6000, 1000, 30000, 30000, 2f))
+        assertEquals(0L, CrossfadeEnvelope.duration(6000, 1000, 0, 30000, 1f))
+        assertEquals(0L, CrossfadeEnvelope.duration(6000, 1000, 30000, 0, 1f))
+        assertEquals(0L, CrossfadeEnvelope.duration(6000, 1000, 30000, 30000, Float.NaN))
+        assertEquals(0L, CrossfadeEnvelope.duration(0, 1000, 30000, 30000, 1f))
+    }
+}
