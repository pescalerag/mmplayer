+package com.doublesymmetry.kotlinaudio.players
+
+import kotlin.math.cos
+import kotlin.math.sin
+
+/** Time is monotonic wall time; paused/buffering time never advances a mix. */
+class CrossfadeEnvelope(durationMs: Long) {
+    var durationMs = durationMs
+        private set
+    var elapsedMs = 0L
+        private set
+    private var anchor: Long? = null
+    fun advance(now: Long, playing: Boolean): Double {
+        val previous = anchor
+        if (previous != null) elapsedMs = (elapsedMs + (now - previous).coerceAtLeast(0)).coerceAtMost(durationMs)
+        anchor = if (playing) now else null
+        return if (durationMs <= 0) 1.0 else (elapsedMs.toDouble() / durationMs).coerceIn(0.0, 1.0)
+    }
+    fun retimeRemaining(remainingMs: Long) {
+        val fraction = if (durationMs <= 0) 1.0 else elapsedMs.toDouble() / durationMs
+        if (fraction >= 1 || remainingMs <= 0) { elapsedMs = durationMs; return }
+        durationMs = (remainingMs / (1 - fraction)).toLong().coerceAtLeast(1)
+        elapsedMs = (fraction * durationMs).toLong()
+    }
+    fun gains(): Pair<Float, Float> {
+        val fraction = if (durationMs <= 0) 1.0 else elapsedMs.toDouble() / durationMs
+        return cos(fraction * Math.PI / 2).toFloat() to sin(fraction * Math.PI / 2).toFloat()
+    }
+    companion object {
+        fun duration(configured: Long, remainingMediaMs: Long, outgoingDuration: Long, incomingDuration: Long, speed: Float): Long {
+            if (configured <= 0 || remainingMediaMs <= 0 || outgoingDuration <= 0 || incomingDuration <= 0 || !speed.isFinite() || speed <= 0) return 0
+            return minOf(configured.toDouble(), remainingMediaMs / speed.toDouble(),
+                outgoingDuration / speed.toDouble() / 2, incomingDuration / speed.toDouble() / 2).toLong().coerceAtLeast(0)
+        }
+    }
+}
