@@ -0,0 +1,56 @@
+package com.doublesymmetry.trackplayer.service
+
+import android.os.Bundle
+import android.os.Handler
+import android.os.Looper
+import com.google.common.util.concurrent.ListenableFuture
+import com.google.common.util.concurrent.SettableFuture
+import org.json.JSONObject
+import java.util.UUID
+import java.util.function.Consumer
+
+/** Requests survive React startup, but never outlive their controller/service or deadline. */
+object AndroidAutoBridge {
+    private val handler = Handler(Looper.getMainLooper())
+    private data class Pending(val request: Bundle, val result: SettableFuture<String>)
+    private val pending = linkedMapOf<String, Pending>()
+    private var listener: Consumer<Bundle>? = null
+    var suppressNextPlay = false
+
+    @JvmStatic fun setListener(consumer: Consumer<Bundle>?) {
+        listener = consumer
+        if (consumer != null) pending.values.toList().forEach { consumer.accept(it.request) }
+    }
+
+    fun request(kind: String, mediaId: String = "", query: String = "", extras: Bundle? = null,
+                index: Int = -1, position: Double = 0.0): ListenableFuture<String> {
+        val id = UUID.randomUUID().toString()
+        val result = SettableFuture.create<String>()
+        val bundle = Bundle().apply {
+            putString("id", id); putString("kind", kind); putString("mediaId", mediaId)
+            putString("query", query); putBundle("extras", extras)
+            putInt("index", index); putDouble("position", position)
+        }
+        pending[id] = Pending(bundle, result)
+        val timeout = Runnable { pending.remove(id)?.result?.setException(IllegalStateException("MMPlayer request timed out")) }
+        handler.postDelayed(timeout, 9000)
+        result.addListener({ handler.removeCallbacks(timeout); pending.remove(id) }, { handler.post(it) })
+        listener?.accept(bundle)
+        return result
+    }
+
+    @JvmStatic fun isPending(id: String): Boolean = pending.containsKey(id)
+
+    @JvmStatic fun complete(id: String, json: String) {
+        val request = pending.remove(id) ?: return
+        val response = JSONObject(json)
+        if (response.has("error")) request.result.setException(IllegalStateException(response.getString("error")))
+        else request.result.set(json)
+    }
+
+    fun cancelAll() {
+        pending.values.toList().forEach { it.result.cancel(false) }
+        pending.clear()
+        suppressNextPlay = false
+    }
+}
