+package com.doublesymmetry.trackplayer.service
+
+import android.content.ContentProvider
+import android.content.ContentValues
+import android.database.Cursor
+import android.graphics.Bitmap
+import android.graphics.BitmapFactory
+import android.net.Uri
+import android.os.ParcelFileDescriptor
+import java.io.File
+import java.io.FileNotFoundException
+import java.security.MessageDigest
+
+/** Only decoded image pixels are exported; arbitrary paths and database files are never exposed. */
+class AutoArtworkProvider : ContentProvider() {
+    companion object {
+        fun uriFor(packageName: String, source: String): Uri = Uri.Builder().scheme("content").authority("$packageName.autoart")
+            .appendPath("image").appendQueryParameter("source", source)
+            .appendQueryParameter("version", if (source.startsWith("file:")) File(Uri.parse(source).path ?: "").lastModified().toString() else "0").build()
+    }
+    override fun onCreate() = true
+    override fun getType(uri: Uri) = "image/png"
+    override fun query(uri: Uri, projection: Array<out String>?, selection: String?, selectionArgs: Array<out String>?, sortOrder: String?): Cursor? = null
+    override fun insert(uri: Uri, values: ContentValues?): Uri? = null
+    override fun delete(uri: Uri, selection: String?, selectionArgs: Array<out String>?) = 0
+    override fun update(uri: Uri, values: ContentValues?, selection: String?, selectionArgs: Array<out String>?) = 0
+
+    override fun openFile(uri: Uri, mode: String): ParcelFileDescriptor {
+        if (mode != "r") throw FileNotFoundException()
+        val ctx = context ?: throw FileNotFoundException()
+        val source = Uri.parse(uri.getQueryParameter("source") ?: throw FileNotFoundException())
+        val local = if (source.scheme == "file") File(source.path ?: "").canonicalFile else null
+        if (local != null && listOf(ctx.filesDir, ctx.cacheDir).none { local.path.startsWith(it.canonicalPath + File.separator) }) throw FileNotFoundException()
+        if (local == null && (source.scheme != "content" || source.authority != "media")) throw FileNotFoundException()
+        val key = "$source:${local?.lastModified() ?: 0}"
+        val name = MessageDigest.getInstance("SHA-256").digest(key.toByteArray()).joinToString("") { "%02x".format(it) }
+        val directory = File(ctx.cacheDir, "android-auto-art").apply { mkdirs() }
+        val output = File(directory, "$name.png")
+        synchronized(this) {
+            if (!output.exists()) {
+                fun stream() = if (local != null) local.inputStream() else ctx.contentResolver.openInputStream(source) ?: throw FileNotFoundException()
+                val options = BitmapFactory.Options().apply { inJustDecodeBounds = true }
+                stream().use { BitmapFactory.decodeStream(it, null, options) }
+                if (options.outWidth <= 0 || options.outHeight <= 0) throw FileNotFoundException()
+                options.inJustDecodeBounds = false
+                while (maxOf(options.outWidth, options.outHeight) / options.inSampleSize.coerceAtLeast(1) > 1024) options.inSampleSize = options.inSampleSize.coerceAtLeast(1) * 2
+                val bitmap = stream().use { BitmapFactory.decodeStream(it, null, options) } ?: throw FileNotFoundException()
+                try { output.outputStream().use { bitmap.compress(Bitmap.CompressFormat.PNG, 100, it) } } finally { bitmap.recycle() }
+                directory.listFiles()?.sortedByDescending { it.lastModified() }?.drop(250)?.forEach { it.delete() }
+            }
+        }
+        return ParcelFileDescriptor.open(output, ParcelFileDescriptor.MODE_READ_ONLY)
+    }
+}
