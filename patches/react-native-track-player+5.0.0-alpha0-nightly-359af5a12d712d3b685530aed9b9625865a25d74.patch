+package com.doublesymmetry.kotlinaudio.players
+
+import android.content.Context
+import androidx.media3.common.C
+import androidx.media3.common.Format
+import androidx.media3.common.audio.AudioProcessor.AudioFormat
+import androidx.media3.common.audio.AudioProcessor.UnhandledAudioFormatException
+import androidx.media3.common.audio.BaseAudioProcessor
+import androidx.media3.extractor.metadata.id3.TextInformationFrame
+import androidx.media3.extractor.metadata.id3.InternalFrame
+import androidx.media3.extractor.metadata.vorbis.VorbisComment
+import java.nio.ByteBuffer
+import java.nio.ByteOrder
+
+/** Per-buffer PCM gain, separate from player volume (fades, ducking and Cast mute). */
+class ReplayGainAudioProcessor(context: Context) : BaseAudioProcessor() {
+    private val preferences = context.getSharedPreferences("mmplayer_replay_gain", Context.MODE_PRIVATE)
+    private var lastFormat: Format? = null
+    private var trackGain: Double? = null
+    private var trackPeak: Double? = null
+    private var explicitGain: Double? = null
+    private var explicitPeak: Double? = null
+    @Volatile private var gain = 1.0
+
+    private fun updateGain() {
+        val effectiveGain = trackGain ?: explicitGain
+        val effectivePeak = trackPeak ?: explicitPeak
+        gain = ReplayGainMath.multiplier(
+            preferences.getBoolean("enabled", false), effectiveGain, effectivePeak,
+            preferences.getFloat("preamp", 0f).toDouble(),
+            preferences.getFloat("fallback", -6f).toDouble()
+        )
+    }
+
+    fun selectFormat(format: Format) {
+        if (lastFormat !== format) {
+            lastFormat = format
+            trackGain = null
+            trackPeak = null
+            explicitGain = null
+            explicitPeak = null
+            format.metadata?.let { metadata ->
+                for (i in 0 until metadata.length()) {
+                    when (val entry = metadata[i]) {
+                        is VorbisComment -> readTag(entry.key, entry.value)
+                        is TextInformationFrame -> if (entry.id == "TXXX") {
+                            readTag(entry.description ?: "", entry.values.firstOrNull() ?: "")
+                        }
+                        is InternalFrame -> when (entry.domain) {
+                            "org.hydrogenaudio.replaygain", "com.apple.iTunes" -> readTag(entry.description, entry.text)
+                            "mmplayer.replaygain" -> {
+                                val number = entry.text.toDoubleOrNull()?.takeIf { it.isFinite() }
+                                if (entry.description == "gain") explicitGain = number
+                                if (entry.description == "peak") explicitPeak = number?.takeIf { it > 0 }
+                            }
+                        }
+                    }
+                }
+            }
+        }
+        updateGain()
+    }
+
+    private fun readTag(key: String, value: String) {
+        val number = value.trim().replace(Regex("(?i)\\s*dB$"), "").trim().toDoubleOrNull()
+            ?.takeIf { it.isFinite() } ?: return
+        when (key.trim().uppercase(java.util.Locale.ROOT)) {
+            "REPLAYGAIN_TRACK_GAIN" -> trackGain = number
+            "REPLAYGAIN_TRACK_PEAK" -> if (number > 0) trackPeak = number
+            "REPLAYGAIN_ALBUM_GAIN" -> if (trackGain == null) trackGain = number
+            "REPLAYGAIN_ALBUM_PEAK" -> if (trackPeak == null && number > 0) trackPeak = number
+        }
+    }
+
+    override fun onConfigure(inputAudioFormat: AudioFormat): AudioFormat {
+        if (inputAudioFormat.encoding != C.ENCODING_PCM_16BIT) {
+            throw UnhandledAudioFormatException(inputAudioFormat)
+        }
+        // Always active, even at unity, so changing settings needs no decoder restart.
+        return inputAudioFormat
+    }
+
+    override fun queueInput(inputBuffer: ByteBuffer) {
+        val output = replaceOutputBuffer(inputBuffer.remaining()).order(ByteOrder.LITTLE_ENDIAN)
+        inputBuffer.order(ByteOrder.LITTLE_ENDIAN)
+        ReplayGainMath.processPcm16(inputBuffer, output, gain)
+        output.flip()
+    }
+}
