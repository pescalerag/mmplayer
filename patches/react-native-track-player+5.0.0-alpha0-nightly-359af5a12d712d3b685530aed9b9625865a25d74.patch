+            `when`(player.totalBufferedDuration).thenAnswer { duration }
+            `when`(player.isPlaying).thenAnswer { this.playing }
+            `when`(player.playWhenReady).thenAnswer { this.playing }
+            `when`(player.playbackState).thenReturn(Player.STATE_READY)
+            `when`(player.playbackParameters).thenAnswer { parameters }
+            `when`(player.repeatMode).thenAnswer { repeat }
+            `when`(player.audioSessionId).thenAnswer { session }
+            `when`(player.volume).thenAnswer { volume }
+            doAnswer { volume = it.getArgument(0); null }.`when`(player).setVolume(anyFloat())
+            doAnswer { parameters = it.getArgument(0); null }.`when`(player).setPlaybackParameters(any(PlaybackParameters::class.java))
+            doAnswer { repeat = it.getArgument(0); null }.`when`(player).setRepeatMode(anyInt())
+            doAnswer { items = it.getArgument(0); index = it.getArgument(1); position = it.getArgument(2); null }.`when`(player).setMediaItems(anyList(), anyInt(), anyLong())
+            doAnswer { listeners.add(it.getArgument(0)); null }.`when`(player).addListener(any(Player.Listener::class.java))
