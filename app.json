{
  "expo": {
    "name": "MMPlayer",
    "slug": "mmplayer",
    "icon": "./src/assets/images/icon.png",
    "version": "2.5.0",
    "orientation": "portrait",
    "scheme": ["mmplayer", "trackplayer"],
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "backgroundColor": "#000000",
    "splash": {
      "image": "./src/assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "permissions": [
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.WAKE_LOCK",
        "android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS",
        "android.permission.WRITE_SETTINGS",
        "com.android.vending.BILLING"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/images/icon.png",
        "backgroundImage": "./src/assets/images/android-icon-background.png",
        "monochromeImage": "./src/assets/images/splash-icon.png"
      },
      "package": "com.pescalerag.mmplayer",
      "versionCode": 33,
      "newArchEnabled": true,
      "navigationBar": {
        "barStyle": "light-content",
        "backgroundColor": "#00000000"
      },
      "statusBar": {
        "translucent": true,
        "barStyle": "light-content",
        "backgroundColor": "#00000000"
      },
      "backgroundColor": "#000000",
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            { "scheme": "content", "mimeType": "audio/*" },
            { "scheme": "file", "mimeType": "audio/*" }
          ],
          "category": ["DEFAULT", "BROWSABLE"]
        },
        {
          "action": "VIEW",
          "data": [
            { "scheme": "content", "mimeType": "application/ogg" },
            { "scheme": "file", "mimeType": "application/ogg" }
          ],
          "category": ["DEFAULT", "BROWSABLE"]
        },
        {
          "action": "VIEW",
          "data": [
            { "scheme": "content", "mimeType": "application/x-ogg" },
            { "scheme": "file", "mimeType": "application/x-ogg" }
          ],
          "category": ["DEFAULT", "BROWSABLE"]
        },
        {
          "action": "VIEW",
          "data": [
            { "scheme": "content", "mimeType": "application/opus" },
            { "scheme": "file", "mimeType": "application/opus" }
          ],
          "category": ["DEFAULT", "BROWSABLE"]
        }
      ]
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "./plugins/withJetifier",
      [
        "react-native-google-cast",
        {
          "receiverAppId": "5622F67E",
          "expandedController": false
        }
      ],
      [
        "@howincodes/expo-dynamic-app-icon",
        {
          "dark": {
            "android": {
              "foregroundImage": "./src/assets/images/app-icons/logoBlack.png",
              "backgroundColor": "#000000"
            },
            "ios": "./src/assets/images/app-icons/logoBlack.png"
          },
          "aqua": {
            "android": {
              "foregroundImage": "./src/assets/images/app-icons/logoAqua.png",
              "backgroundColor": "#00656D"
            },
            "ios": "./src/assets/images/app-icons/logoAqua.png"
          },
          "develpink": {
            "android": {
              "foregroundImage": "./src/assets/images/app-icons/logodevelETSII.png",
              "backgroundColor": "#B781D7"
            },
            "ios": "./src/assets/images/app-icons/logodevelETSII.png"
          },
          "labgreen": {
            "android": {
              "foregroundImage": "./src/assets/images/app-icons/logoGreen.png",
              "backgroundColor": "#00592C"
            },
            "ios": "./src/assets/images/app-icons/logoGreen.png"
          },
          "pink": {
            "android": {
              "foregroundImage": "./src/assets/images/app-icons/logoMagenta.png",
              "backgroundColor": "#850069"
            },
            "ios": "./src/assets/images/app-icons/logoMagenta.png"
          },
          "red": {
            "android": {
              "foregroundImage": "./src/assets/images/app-icons/logoRed.png",
              "backgroundColor": "#820000"
            },
            "ios": "./src/assets/images/app-icons/logoRed.png"
          },
          "white": {
            "android": {
              "foregroundImage": "./src/assets/images/app-icons/logoWhite.png",
              "backgroundColor": "#FFFFFF"
            },
            "ios": "./src/assets/images/app-icons/logoWhite.png"
          },
          "yellow": {
            "android": {
              "foregroundImage": "./src/assets/images/app-icons/logoYellow.png",
              "backgroundColor": "#5D4900"
            },
            "ios": "./src/assets/images/app-icons/logoYellow.png"
          },
          "supporter": {
            "android": {
              "foregroundImage": "./src/assets/images/app-icons/logoAqua.png",
              "backgroundColor": "#00656D"
            },
            "ios": "./src/assets/images/app-icons/logoAqua.png"
          },
          "retro": {
            "android": {
              "foregroundImage": "./src/assets/images/app-icons/logoMagenta.png",
              "backgroundColor": "#850069"
            },
            "ios": "./src/assets/images/app-icons/logoMagenta.png"
          },
          "darkblue": {
            "android": {
              "foregroundImage": "./src/assets/images/app-icons/logoAqua.png",
              "backgroundColor": "#00656D"
            },
            "ios": "./src/assets/images/app-icons/logoAqua.png"
          },
          "orange": {
            "android": {
              "foregroundImage": "./src/assets/images/app-icons/logoYellow.png",
              "backgroundColor": "#5D4900"
            },
            "ios": "./src/assets/images/app-icons/logoYellow.png"
          },
          "legend": {
            "android": {
              "foregroundImage": "./src/assets/images/app-icons/logoLegend.png",
              "backgroundColor": "#0A1511"
            },
            "ios": "./src/assets/images/app-icons/logoLegend.png"
          }
        }
      ],
      "./plugins/withAdaptiveIconFallbacks",
      "./plugins/withAndroidAuto"
    ],
    "web": {
      "output": "static"
    },
    "experiments": {
      "typedRoutes": true
    },
    "androidNavigationBar": {
      "backgroundColor": "#000000",
      "barStyle": "light-content"
    }
  }
}
