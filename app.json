{
  "expo": {
    "name": "MMPlayer",
    "slug": "mmplayer",
    "icon": "./src/assets/images/icon.png",
    "version": "2.2.0",
    "orientation": "portrait",
    "scheme": "mmplayer",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "backgroundColor": "#000000",
    "splash": {
      "image": "./src/assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "permissions": [
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.WAKE_LOCK",
        "android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS",
        "com.android.vending.BILLING"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/images/android-icon-foreground.png",
        "backgroundImage": "./src/assets/images/android-icon-background.png"
      },
      "package": "com.pescalerag.mmplayer",
      "versionCode": 22,
      "newArchEnabled": true,
      "navigationBar": {
        "barStyle": "light-content",
        "backgroundColor": "#00000000"
      },
      "statusBar": {
        "translucent": true,
        "barStyle": "light-content",
        "backgroundColor": "#00000000"
      },
      "backgroundColor": "#000000"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to allow you to set artist and album covers."
        }
      ],
      [
        "expo-media-library",
        {
          "granularPermissions": [
            "audio"
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "./plugins/withJetifier",

      [
        "react-native-google-cast",
        {
          "receiverAppId": "5622F67E",
          "expandedController": false
        }
      ],
      [
        "@howincodes/expo-dynamic-app-icon",
        {
          "dark": {
            "image": "./src/assets/images/dark-icon.png",
            "android": "./src/assets/images/dark-icon.png",
            "ios": "./src/assets/images/dark-icon.png"
          },
          "supporter": {
            "image": "./src/assets/images/supporter-icon.png",
            "android": "./src/assets/images/supporter-icon.png",
            "ios": "./src/assets/images/supporter-icon.png"
          },
          "retro": {
            "image": "./src/assets/images/retro-icon.png",
            "android": "./src/assets/images/retro-icon.png",
            "ios": "./src/assets/images/retro-icon.png"
          },
          "darkblue": {
            "image": "./src/assets/images/android-icon-darkblue.png",
            "android": "./src/assets/images/android-icon-darkblue.png",
            "ios": "./src/assets/images/android-icon-darkblue.png"
          },
          "develpink": {
            "image": "./src/assets/images/android-icon-devel-pink.png",
            "android": "./src/assets/images/android-icon-devel-pink.png",
            "ios": "./src/assets/images/android-icon-devel-pink.png"
          },
          "labgreen": {
            "image": "./src/assets/images/android-icon-labgreen.png",
            "android": "./src/assets/images/android-icon-labgreen.png",
            "ios": "./src/assets/images/android-icon-labgreen.png"
          },
          "orange": {
            "image": "./src/assets/images/android-icon-orange.png",
            "android": "./src/assets/images/android-icon-orange.png",
            "ios": "./src/assets/images/android-icon-orange.png"
          },
          "pink": {
            "image": "./src/assets/images/android-icon-pink.png",
            "android": "./src/assets/images/android-icon-pink.png",
            "ios": "./src/assets/images/android-icon-pink.png"
          },
          "red": {
            "image": "./src/assets/images/android-icon-red.png",
            "android": "./src/assets/images/android-icon-red.png",
            "ios": "./src/assets/images/android-icon-red.png"
          },
          "white": {
            "image": "./src/assets/images/android-icon-white.png",
            "android": "./src/assets/images/android-icon-white.png",
            "ios": "./src/assets/images/android-icon-white.png"
          }
        }
      ]
    ],
    "web": {
      "output": "static"
    },
    "experiments": {
      "typedRoutes": true
    },
    "androidNavigationBar": {
      "backgroundColor": "#000000",
      "barStyle": "light-content"
    }
  }
}